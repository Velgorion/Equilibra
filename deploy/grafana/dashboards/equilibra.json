      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(rate(relay_events_published_total[$__rate_interval]))",
          "legendFormat": "published",
          "range": true,
          "editorMode": "code"
        }
      ]
    },
